# Server-side Anthropic key. Optional.
#
# If set, everyone who opens the deployed app gets AI coaching without pasting a key
# (your account pays). If unset, the app still works: each visitor can paste their own
# key in Settings, and without any key it falls back to local heuristic scoring.
#
# Never prefix this with NEXT_PUBLIC_ — that would ship the key to the browser.
ANTHROPIC_API_KEY=

# Optional: pin a model. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
